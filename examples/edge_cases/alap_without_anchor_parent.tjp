project d "alap_without_anchor_parent" 2026-11-02 +4w {
  timingresolution 30min
  scheduling asap
}
resource r1 "Analyst" {
  workinghours mon - fri 8:30 - 17:30
  timezone "Europe/London"
  limits { dailymax 450min }
}
task g "Group" {
  scheduling alap
  task a "A" { effort 240min allocate r1  }
